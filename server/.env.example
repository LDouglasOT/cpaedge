# ---- Server ----
PORT=4000
ADMIN_PASSWORD=
AUTH_SECRET=
DATA_DIR=./data
# Dev only: the Vite dev server origin
CLIENT_ORIGIN=http://localhost:5173

# ---- MarzPay (https://wallet.wearemarz.com) ----
PAYMENT_PROVIDER=marzpay
MARZPAY_API_KEY=
MARZPAY_API_SECRET=
# Dashboard > webhook settings: enable signing and paste the signing secret here
MARZPAY_WEBHOOK_SECRET=
# Public https address of this server, so MarzPay can reach /api/payments/webhook/marzpay
PUBLIC_URL=
